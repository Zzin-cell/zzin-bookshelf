{
  "name": "weread-bookshelf",
  "version": "1.0.0",
  "description": "张紫宁 · 一点有意思的书 — Cloudflare Pages + Worker + GitHub. Build pipeline reads Obsidian vault and emits public/data/{books,more}.json + mirrored assets.",
  "type": "module",
  "main": "scripts/parse_books.mjs",
  "scripts": {
    "build:books": "node scripts/parse_books.mjs",
    "build:more": "node scripts/parse_more.mjs",
    "build": "npm run build:books && npm run build:more",
    "clean": "node -e \"const fs=require('fs');for(const f of ['data/books.json','public/data/books.json','data/more.json','public/data/more.json']){try{fs.unlinkSync(f)}catch(_){}}\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zzin-cell/zzin-bookshelf.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14"
  }
}